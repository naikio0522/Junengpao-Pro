# Server-only example. Never put these values in Electron or a public repo.
JNP_DB_HOST=your-rds-hostname
JNP_DB_PORT=3306
JNP_DB_NAME=junengpao
JNP_DB_USER=server-only-user
JNP_DB_PASSWORD=replace-on-server
JNP_DB_CA_FILE=/etc/junengpao/rds-ca.pem
# Set to 1 for the existing RDS with account_users/account_sessions only.
# This disables all membership orders and treats every account as free.
JNP_ACCOUNT_ONLY_MODE=1
# Leave public account routes disabled until 002_account_rate_limits.sql is
# migrated, HTTPS ingress is ready, and the secret below is set on the server.
JNP_PUBLIC_ACCOUNTS=0
JNP_RATE_LIMIT_HMAC_KEY=

# Payment remains unavailable until production provider adapters are installed.
JNP_PAYMENT_NOTIFY_BASE_URL=https://api.example.com
JNP_ALIPAY_APP_ID=
JNP_WECHAT_MCHID=
JNP_MEMBERSHIP_PLANS_JSON=[]
