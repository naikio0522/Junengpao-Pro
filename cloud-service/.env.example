# Server-only example. Never put these values in Electron or a public repo.
JNP_DB_HOST=your-rds-hostname
JNP_DB_PORT=3306
JNP_DB_NAME=junengpao
JNP_DB_USER=server-only-user
JNP_DB_PASSWORD=replace-on-server
JNP_DB_CA_FILE=/etc/junengpao/rds-ca.pem

# Payment remains unavailable until production provider adapters are installed.
JNP_PAYMENT_NOTIFY_BASE_URL=https://api.example.com
JNP_ALIPAY_APP_ID=
JNP_WECHAT_MCHID=
JNP_MEMBERSHIP_PLANS_JSON=[]
